<?xml version="1.0" encoding="UTF-8"?>

<compiler_spec>
    <data_organization>
        <pointer_size value="3" />
    </data_organization>
    <global>
        <range space="ram"/>
    </global>
    <stackpointer register="S" space="ram"/>
    <default_proto>
        <prototype name="default" extrapop="unknown" stackshift="0">
            <input></input>
            <output></output>
        </prototype>
    </default_proto>
</compiler_spec>
