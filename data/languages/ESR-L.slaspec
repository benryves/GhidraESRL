:OR IntBPPX8,imm8 is op0_8=0x24; op0_8=0x79; IntBPPX8; imm8 { or(IntBPPX8, imm8); }

:XOR IntN8,imm8    is op0_8=0x30; op0_8=0x69; IntN8;    imm8 { xor(IntN8, imm8);    }
