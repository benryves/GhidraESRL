# mv r20,[imm20]

:MV R20L,Ext24 is op3_5=0x11 & R20L; Ext24 { R20L = Ext24; }

# mvp (int),[imm20]

:MVP IntN24,Ext24    is op0_8=0x30; op0_8=0xD2; IntN24;    Ext24 { IntN24 = Ext24;    }
:MVP IntBP24,Ext24   is             op0_8=0xD2; IntBP24;   Ext24 { IntBP24 = Ext24;   }
:MVP IntPX24,Ext24   is op0_8=0x34; op0_8=0xD2; IntPX24;   Ext24 { IntPX24 = Ext24;   }
:MVP IntBPPX24,Ext24 is op0_8=0x24; op0_8=0xD2; IntBPPX24; Ext24 { IntBPPX24 = Ext24; }

# mv xyu,[r20]

:MV XYUL,Ptr20 is op3_5=0b10010 & XYUL; op3_5=0b00000 & Ptr20 { XYUL = Ptr20; }

# mvp (int),[r20]

:MVP IntN24,Ptr24    is op0_8=0x30; op0_8=0xE2; op3_5=0b0000 & Ptr24; IntN24    { IntN24 = Ptr24;    }
:MVP IntBP24,Ptr24   is             op0_8=0xE2; op3_5=0b0000 & Ptr24; IntBP24   { IntBP24 = Ptr24;   }
:MVP IntPX24,Ptr24   is op0_8=0x34; op0_8=0xE2; op3_5=0b0000 & Ptr24; IntPX24   { IntPX24 = Ptr24;   }
:MVP IntBPPX24,Ptr24 is op0_8=0x24; op0_8=0xE2; op3_5=0b0000 & Ptr24; IntBPPX24 { IntBPPX24 = Ptr24; }

### 3 Byte Transmission Command No. 2

# mv xyu,[r20++]
# mv xyu,[--r20]

:MV XYUL,MemRegIncDec20 is op3_5=0b10010 & XYUL; MemRegIncDec20 { XYUL = MemRegIncDec20; }

# mvp (int),[r20++]
# mvp (int),[--r20]

:MVP IntN24,MemRegIncDec20    is op0_8=0x30; op0_8=0xE2; MemRegIncDec20; IntN24    { IntN24 = MemRegIncDec20;    }
:MVP IntBP24,MemRegIncDec20   is             op0_8=0xE2; MemRegIncDec20; IntBP24   { IntBP24 = MemRegIncDec20;   }
:MVP IntPX24,MemRegIncDec20   is op0_8=0x34; op0_8=0xE2; MemRegIncDec20; IntPX24   { IntPX24 = MemRegIncDec20;   }
