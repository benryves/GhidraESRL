### Transmission Command Between a and b

:MV A,B is op0_8=0x74 & A & B { A = B; }
:MV B,A is op0_8=0x75 & B & A { B = A; }

### Exchange Command

macro ex8_8(a, b) { tmp:1 = a; a = b; b = tmp; }
macro ex16_16(a, b) { tmp:2 = a; a = b; b = tmp; }
macro ex20_20(a, b) { tmp:3 = a; a = b; b = tmp; }
macro ex24_24(a, b) { tmp:3 = a; a = b; b = tmp; }

macro ex8_16(a, b) { tmp:1 = a; a = b[0, 7]; b = 0; b[0, 7] = tmp; }
macro ex8_20(a, b) { tmp:1 = a; a = b[0, 7]; b = 0; b[0, 7] = tmp; }

macro ex16_8(a, b) { tmp:2 = a; a = 0; a[0, 7] = b; b = tmp[0, 7]; }
macro ex16_20(a, b) { tmp:2 = a; a = b[0, 15]; b = 0; b[0, 15] = tmp; }

macro ex20_8(a, b) { tmp:3 = a; a = 0; a[0, 7] = b; b = tmp[0, 7]; }
macro ex20_16(a, b) { tmp:3 = a; a = 0; a[0, 15] = b; b = tmp[0, 15]; }

macro exl(a, b) {
	
	src:3 = a;
	dst:3 = b;
	
<loop>
	
	tmp:1 = *:1 src;
	*:1 src = *:1 dst;
	*:1 dst = tmp;
	
	src = src + 1;
	dst = dst + 1;
	I = I - 1;
	
	if (I != 0) goto <loop>;
}

:EX A,B is op0_8=0xDD & A & B { ex8_8(A, B); }

:EX R8H,R8L  is op0_8=0xED; R8H & R8L  { ex8_8(R8H, R8L);   }
:EX R8H,R16L is op0_8=0xED; R8H & R16L { ex8_16(R8H, R16L); }
