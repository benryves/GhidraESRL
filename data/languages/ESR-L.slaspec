:MVW [IntN20],IntN16_2     is op0_8=0x32; op0_8=0xF9; op0_8=0x00; IntN20;    IntN16_2  { wr16(IntN20, IntN16_2);     }
:MVW [IntBP20],IntN16      is op0_8=0x22; op0_8=0xF9; op0_8=0x00; IntBP20;   IntN16    { wr16(IntBP20, IntN16);      }
:MVW [IntPX20],IntN16      is op0_8=0x36; op0_8=0xF9; op0_8=0x00; IntPX20;   IntN16    { wr16(IntPX20, IntN16);      }
:MVW [IntBPPX20],IntN16    is op0_8=0x26; op0_8=0xF9; op0_8=0x00; IntBPPX20; IntN16    { wr16(IntBPPX20, IntN16);    }
:MVW [IntN20],IntBP16      is op0_8=0x30; op0_8=0xF9; op0_8=0x00; IntN20;    IntBP16   { wr16(IntN20, IntBP16);      }
:MVW [IntBP20],IntBP16_2   is             op0_8=0xF9; op0_8=0x00; IntBP20;   IntBP16_2 { wr16(IntBP20, IntBP16_2);   }
:MVW [IntPX20],IntBP16     is op0_8=0x34; op0_8=0xF9; op0_8=0x00; IntPX20;   IntBP16   { wr16(IntPX20, IntBP16);     }
:MVW [IntBPPX20],IntBP16   is op0_8=0x24; op0_8=0xF9; op0_8=0x00; IntBPPX20; IntBP16   { wr16(IntBPPX20, IntBP16);   }
:MVW [IntN20],IntPY16      is op0_8=0x33; op0_8=0xF9; op0_8=0x00; IntN20;    IntPY16   { wr16(IntN20, IntPY16);      }
:MVW [IntBP20],IntPY16     is op0_8=0x23; op0_8=0xF9; op0_8=0x00; IntBP20;   IntPY16   { wr16(IntBP20, IntPY16);     }
:MVW [IntPX20],IntPY16     is op0_8=0x37; op0_8=0xF9; op0_8=0x00; IntPX20;   IntPY16   { wr16(IntPX20, IntPY16);     }
:MVW [IntBPPX20],IntPY16   is op0_8=0x27; op0_8=0xF9; op0_8=0x00; IntBPPX20; IntPY16   { wr16(IntBPPX20, IntPY16);   }
:MVW [IntN20],IntBPPY16    is op0_8=0x31; op0_8=0xF9; op0_8=0x00; IntN20;    IntBPPY16 { wr16(IntN20, IntBPPY16);    }
:MVW [IntBP20],IntBPPY16   is op0_8=0x21; op0_8=0xF9; op0_8=0x00; IntBP20;   IntBPPY16 { wr16(IntBP20, IntBPPY16);   }
:MVW [IntPX20],IntBPPY16   is op0_8=0x35; op0_8=0xF9; op0_8=0x00; IntPX20;   IntBPPY16 { wr16(IntPX20, IntBPPY16);   }
:MVW [IntBPPX20],IntBPPY16 is op0_8=0x25; op0_8=0xF9; op0_8=0x00; IntBPPX20; IntBPPY16 { wr16(IntBPPX20, IntBPPY16); }

