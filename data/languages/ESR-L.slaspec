:MVW [IntN20+off8],IntN16       is op0_8=0x32; op0_8=0xF9; op0_8=0x80; IntN20;    IntN16;    off8 { wr16(IntN20+off8, IntN16);       }
:MVW [IntBP20+off8],IntN16      is op0_8=0x22; op0_8=0xF9; op0_8=0x80; IntBP20;   IntN16;    off8 { wr16(IntBP20+off8, IntN16);      }
