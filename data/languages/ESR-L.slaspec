### Dyadic Operation No.1 (Add/Subtract Command)

macro add8_8(a, b) {
	C = carry(a, b);
	a = a + b;
	Z = a == 0;
}
macro sub8_8(a, b) {
	C = a < b;
	a = a - b;
	Z = a == 0;
}
macro adc8_8(a, b) {
	local C_copy:1 = C;
	C = carry(a, b);
	a = a + b;
	C = C || carry(a, C_copy);	
	a = a + C_copy;
	Z = a == 0;
}
macro sbc8_8(a, b) {
	local C_copy:1 = C;
	C = a < b;
	a = a - b;
	C = C || a < C_copy;
	a = a - C_copy;
	Z = a == 0;
}
macro add8_16(a, b) { add8_8(a, b:1); }
macro sub8_16(a, b) { sub8_8(a, b:1); }
macro add8_20(a, b) { add8_8(a, b:1); }
macro sub8_20(a, b) { sub8_8(a, b:1); }


macro add16_16(a, b) {
	C = carry(a, b);
	a = a + b;
	Z = a == 0;
}
macro sub16_16(a, b) {
	C = a < b;
	a = a - b;
	Z = a == 0;
}
macro adc16_16(a, b) {
	local C_copy:1 = C;
	C = carry(a, b);
	a = a + b;
	C = C || carry(a, C_copy);	
	a = a + C_copy;
	Z = a == 0;
}
macro sbc16_16(a, b) {
	local C_copy:1 = C;
	C = a < b;
	a = a - b;
	C = C || a < C_copy;
	a = a - C_copy;
	Z = a == 0;
}
macro add16_8(a, b) { add16_16(a, zext(b)); }
macro sub16_8(a, b) { add16_16(a, zext(b)); }
macro add16_20(a, b) { add16_16(a, b:2); }
macro sub16_20(a, b) { add16_16(a, b:2); }

macro add20_20(a, b) {
	a = a & 0xFFFFF;
	b = b & 0xFFFFF;
	C = (a + b) > 0xFFFFF;
	a = (a + b) & 0xFFFFF;
	Z = a == 0;
}
macro sub20_20(a, b) {
	a = a & 0xFFFFF;
	b = b & 0xFFFFF;
	C = a < b;
	a = (a - b) & 0xFFFFF;
	Z = a == 0;
}
macro adc20_20(a, b) {
	a = a & 0xFFFFF;
	b = b & 0xFFFFF;
	local C_copy:1 = C;
	C = (a + b) > 0xFFFFF;
	a = (a + b) & 0xFFFFF;
	C = C || (a + C_copy) > 0xFFFFF;
	a = (a + C_copy) & 0xFFFFF;
	Z = a == 0;
}
macro sbc20_20(a, b) {
	a = a & 0xFFFFF;
	b = b & 0xFFFFF;
	local C_copy:1 = C;
	C = a < b;
	a = (a - b) & 0xFFFFF;
	C = C || (a < C_copy);
	a = (a - C_copy) & 0xFFFFF;
	Z = a == 0;
}
macro add20_8(a, b) { add20_20(a, zext(b)); }
macro sub20_8(a, b) { add20_20(a, zext(b)); }
macro add20_16(a, b) { add20_20(a, zext(b)); }
macro sub20_16(a, b) { add20_20(a, zext(b)); }

:ADD A,imm8 is op0_8=0x40 & A; imm8 { add8_8(A, imm8); }
:SUB A,imm8 is op0_8=0x48 & A; imm8 { sub8_8(A, imm8); }
:ADC A,imm8 is op0_8=0x50 & A; imm8 { adc8_8(A, imm8); }
:SBC A,imm8 is op0_8=0x58 & A; imm8 { sbc8_8(A, imm8); }

