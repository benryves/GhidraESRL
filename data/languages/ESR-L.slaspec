### Dyadic Operation No.3 (Pointer Add Command)

# TODO: Does this affect 8 bit values or 20 bit values? Can src be signed?
macro pmdf(dst, src) {
	dst = dst + src;
}

:PMDF IntN8,imm8    is op0_8=0x30; op0_8=0x47; IntN8;    imm8 { pmdf(IntN8, imm8);    }
:PMDF IntBP8,imm8   is             op0_8=0x47; IntBP8;   imm8 { pmdf(IntBP8, imm8);   }
:PMDF IntPX8,imm8   is op0_8=0x34; op0_8=0x47; IntPX8;   imm8 { pmdf(IntPX8, imm8);   }
:PMDF IntBPPX8,imm8 is op0_8=0x24; op0_8=0x47; IntBPPX8; imm8 { pmdf(IntBPPX8, imm8); }

:PMDF IntN8,A    is op0_8=0x30; op0_8=0x57; IntN8    & A { pmdf(IntN8, A);    }
:PMDF IntBP8,A   is             op0_8=0x57; IntBP8   & A { pmdf(IntBP8, A);   }
:PMDF IntPX8,A   is op0_8=0x34; op0_8=0x57; IntPX8   & A { pmdf(IntPX8, A);   }
:PMDF IntBPPX8,A is op0_8=0x24; op0_8=0x57; IntBPPX8 & A { pmdf(IntBPPX8, A); }

### Dyadic Operation No.4 (Compare Command)

macro cmp(dst, src) {
	C = dst < src;
	Z = dst == src;
}

macro cmpw(dst, src) {
	C = dst < src;
	Z = dst == src;
}

macro cmpp20(dst, src) {
	# Sleigh complains if you use [0, 19]?
	C = dst < src;
	Z = dst == src;
}

macro cmpp24(dst, src) {
	C = dst < src;
	Z = dst == src;
}

:CMP A,imm8 is op0_8=0x60 & A; imm8 { }

:CMP IntN8,imm8    is op0_8=0x30; op0_8=0x61; IntN8;    imm8 { cmp(IntN8, imm8);    }
