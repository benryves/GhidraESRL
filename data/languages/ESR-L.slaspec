### Dyadic Operation No.2 (Logical Operation Command)

macro and(dst, src) {
	dst = dst & src;
	Z = dst == 0;
}

macro or(dst, src) {
	dst = dst | src;
	Z = dst == 0;
}

macro xor(dst, src) {
	dst = dst ^ src;
	Z = dst == 0;
}

:AND A,imm8 is op0_8=0x70 & A; imm8 { and(A, imm8); }
:OR A,imm8  is op0_8=0x78 & A; imm8 { or(A, imm8);  }
:XOR A,imm8 is op0_8=0x68 & A; imm8 { xor(A, imm8); }

:AND IntN8,imm8    is op0_8=0x30; op0_8=0x71; IntN8;    imm8 { and(IntN8, imm8);    }
:AND IntBP8,imm8   is             op0_8=0x71; IntBP8;   imm8 { and(IntBP8, imm8);   }
:AND IntPX8,imm8   is op0_8=0x34; op0_8=0x71; IntPX8;   imm8 { and(IntPX8, imm8);   }
:AND IntBPPX8,imm8 is op0_8=0x24; op0_8=0x71; IntBPPX8; imm8 { and(IntBPPX8, imm8); }

:OR IntN8,imm8    is op0_8=0x30; op0_8=0x79; IntN8;    imm8 { or(IntN8, imm8);    }
