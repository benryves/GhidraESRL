:XOR IntPX8,imm8   is op0_8=0x34; op0_8=0x69; IntPX8;   imm8 { xor(IntPX8, imm8);   }
:XOR IntBPPX8,imm8 is op0_8=0x24; op0_8=0x69; IntBPPX8; imm8 { xor(IntBPPX8, imm8); }

