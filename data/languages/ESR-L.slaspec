### Dyadic Operation No.5 (Test Command)


macro test(dst, src) {
	Z = (dst & src) == 0;
}

:TEST A,imm8 is op0_8=0x64 & A; imm8 { test(A, imm8); }

:TEST IntN8,imm8    is op0_8=0x30; op0_8=0x65; IntN8;    imm8 { test(IntN8, imm8);    }
:TEST IntBP8,imm8   is             op0_8=0x65; IntBP8;   imm8 { test(IntBP8, imm8);   }
:TEST IntPX8,imm8   is op0_8=0x34; op0_8=0x65; IntPX8;   imm8 { test(IntPX8, imm8);   }
:TEST IntBPPX8,imm8 is op0_8=0x24; op0_8=0x65; IntBPPX8; imm8 { test(IntBPPX8, imm8); }

:TEST IntN8,A    is op0_8=0x30; op0_8=0x67; IntN8    & A { test(IntN8, A);    }
:TEST IntBP8,A   is             op0_8=0x67; IntBP8   & A { test(IntBP8, A);   }
:TEST IntPX8,A   is op0_8=0x34; op0_8=0x67; IntPX8   & A { test(IntPX8, A);   }
:TEST IntBPPX8,A is op0_8=0x24; op0_8=0x67; IntBPPX8 & A { test(IntBPPX8, A); }

:TEST Ext8,imm8 is op0_8=0x66; Ext8; imm8 { test(Ext8, imm8); }

### Monadic Operation

:SWAP A is A & op0_8=0xEE {
	A = ((A & 0x0F) << 4) | ((A & 0xF0) >> 4);
	Z = (A == 0);
}

macro inc8(dst) {
	dst = dst + 1;
	Z = (dst == 0);
}
macro inc16(dst) {
	dst = dst + 1;
	Z = (dst == 0);
}
macro inc20(dst) {
	dst = (dst + 1) & 0xFFFFF;
	Z = (dst == 0);
}

macro dec8(dst) {
	dst = dst - 1;
	Z = (dst == 0);
}
macro dec16(dst) {
	dst = dst - 1;
	Z = (dst == 0);
}
macro dec20(dst) {
	dst = (dst - 1) & 0xFFFFF;
	Z = (dst == 0);
}

:INC R8L  is op0_8=0x6C; op3_5=0x00 & R8L  { inc8(R8L);   }
:DEC R8L  is op0_8=0x7C; op3_5=0x00 & R8L  { dec8(R8L);   }
:INC R16L is op0_8=0x6C; op3_5=0x00 & R16L { inc16(R16L); }
:DEC R16L is op0_8=0x7C; op3_5=0x00 & R16L { dec16(R16L); }
:INC R20L is op0_8=0x6C; op3_5=0x00 & R20L { inc20(R20L); }
:DEC R20L is op0_8=0x7C; op3_5=0x00 & R20L { dec20(R20L); }

:INC IntN8    is op0_8=0x30; op0_8=0x6D; IntN8    { inc8(IntN8);    }
:DEC IntN8    is op0_8=0x30; op0_8=0x7D; IntN8    { dec8(IntN8);    }
:INC IntBP8   is             op0_8=0x6D; IntBP8   { inc8(IntBP8);   }
:DEC IntBP8   is             op0_8=0x7D; IntBP8   { dec8(IntBP8);   }
:INC IntPX8   is op0_8=0x34; op0_8=0x6D; IntPX8   { inc8(IntPX8);   }
:DEC IntPX8   is op0_8=0x34; op0_8=0x7D; IntPX8   { dec8(IntPX8);   }
:INC IntBPPX8 is op0_8=0x24; op0_8=0x6D; IntBPPX8 { inc8(IntBPPX8); }
:DEC IntBPPX8 is op0_8=0x24; op0_8=0x7D; IntBPPX8 { dec8(IntBPPX8); }

macro ror(dst) {
	C = dst & 1;
	dst = (dst >> 1) | (dst << 7);
	Z = (dst == 0);
}
macro rol(dst) {
	C = dst >> 7;
	dst = (dst << 1) | (dst >> 7);
	Z = (dst == 0);
}

:ROR A is A & op0_8=0xE4 { ror(A); }
:ROL A is A & op0_8=0xE6 { rol(A); }

:ROR IntN8    is op0_8=0x30; op0_8=0xE5; IntN8    { ror(IntN8);    }
:ROL IntN8    is op0_8=0x30; op0_8=0xE7; IntN8    { rol(IntN8);    }
:ROR IntBP8   is             op0_8=0xE5; IntBP8   { ror(IntBP8);   }
:ROL IntBP8   is             op0_8=0xE7; IntBP8   { rol(IntBP8);   }
:ROR IntPX8   is op0_8=0x34; op0_8=0xE5; IntPX8   { ror(IntPX8);   }
:ROL IntPX8   is op0_8=0x34; op0_8=0xE7; IntPX8   { rol(IntPX8);   }
:ROR IntBPPX8 is op0_8=0x24; op0_8=0xE5; IntBPPX8 { ror(IntBPPX8); }
:ROL IntBPPX8 is op0_8=0x24; op0_8=0xE7; IntBPPX8 { rol(IntBPPX8); }

macro shr(dst) {
	local tmp = dst;
	dst = (dst >> 1) | (C << 7);
	C = tmp & 1;
	Z = (dst == 0);
}
macro shl(dst) {
	local tmp = dst;
	dst = (dst << 1) | C;
	C = tmp >> 7;
	Z = (dst == 0);
}

:SHR A is A & op0_8=0xF4 { shr(A); }
:SHL A is A & op0_8=0xF6 { shl(A); }

:SHR IntN8    is op0_8=0x30; op0_8=0xF5; IntN8    { shr(IntN8);    }
:SHL IntN8    is op0_8=0x30; op0_8=0xF7; IntN8    { shl(IntN8);    }
:SHR IntBP8   is             op0_8=0xF5; IntBP8   { shr(IntBP8);   }
:SHL IntBP8   is             op0_8=0xF7; IntBP8   { shl(IntBP8);   }
:SHR IntPX8   is op0_8=0x34; op0_8=0xF5; IntPX8   { shr(IntPX8);   }
:SHL IntPX8   is op0_8=0x34; op0_8=0xF7; IntPX8   { shl(IntPX8);   }
:SHR IntBPPX8 is op0_8=0x24; op0_8=0xF5; IntBPPX8 { shr(IntBPPX8); }
:SHL IntBPPX8 is op0_8=0x24; op0_8=0xF7; IntBPPX8 { shl(IntBPPX8); }

macro dsrl(dst) {
	
	local addr:3 = dst;
	local last:1 = 0;
	local next:1 = 0;
	local tmp:1 = 0;
	
	Z = 1;
	
<loop>
	next = *:1 addr;
	tmp = ((*:1 addr) >> 4) | (last << 4);
	*:1 addr = tmp;
	last = next;
	
	Z = Z && (tmp == 0);
	
	addr = (addr + 1) & 0xFF;	
	I = I - 1;
	
	if (I != 0) goto <loop>;
}

macro dsll(dst) {
	
	local addr:3 = dst;
	local last:1 = 0;
	local next:1 = 0;
	local tmp:1 = 0;
	
	Z = 1;

<loop>
	next = *:1 addr;
	tmp = ((*:1 addr) << 4) | (last >> 4);
	*:1 addr = tmp;
	last = next;
	
	Z = Z && (tmp == 0);
	
	addr = (addr - 1) & 0xFF;	
	I = I - 1;
	
	if (I != 0) goto <loop>;
}

:DSRL IntNAddr    is op0_8=0x30; op0_8=0xFC; IntNAddr    { dsrl(IntNAddr);    }
:DSLL IntNAddr    is op0_8=0x30; op0_8=0xEC; IntNAddr    { dsll(IntNAddr);    }
:DSRL IntBPAddr   is             op0_8=0xFC; IntBPAddr   { dsrl(IntBPAddr);   }
:DSLL IntBPAddr   is             op0_8=0xEC; IntBPAddr   { dsll(IntBPAddr);   }
:DSRL IntPXAddr   is op0_8=0x34; op0_8=0xFC; IntPXAddr   { dsrl(IntPXAddr);   }
:DSLL IntPXAddr   is op0_8=0x34; op0_8=0xEC; IntPXAddr   { dsll(IntPXAddr);   }
:DSRL IntBPPXAddr is op0_8=0x24; op0_8=0xFC; IntBPPXAddr { dsrl(IntBPPXAddr); }
:DSLL IntBPPXAddr is op0_8=0x24; op0_8=0xEC; IntBPPXAddr { dsll(IntBPPXAddr); }

### C FLAG Control Command

:SC is op0_8=0x97 { C = 1; }
:RC is op0_8=0x9F { C = 0; }

### PUSH POP Command

macro pushU8(val8)   { U = U - 1; ptr:3 = U; *:1 ptr = val8;  }
macro popU8(ret8)    { ptr:3 = U; ret8 = *:1 ptr; U = U + 1; }
macro pushU16(val16) { U = U - 2; ptr:3 = U; *:2 ptr = val16; }
macro popU16(ret16)  { ptr:3 = U; ret16 = *:2 ptr; U = U + 2; }
macro pushU20(val20) { U = U - 3; ptr:3 = U; *:3 ptr = val20; }
macro popU20(ret20)  { ptr:3 = U; ret20 = *:3 ptr; U = U + 3; }

macro pushS8(val8)   { S = S - 1; ptr:3 = S; *:1 ptr = val8; }
macro popS8(ret8)    { ptr:3 = S; ret8 = *:1 ptr; S = S + 1; }
macro pushS16(val16) { S = S - 2; ptr:3 = S; *:2 ptr = val16; }
macro popS16(ret16)  { ptr:3 = S; ret16 = *:2 ptr; S = S + 2; }
macro pushS20(val20) { S = S - 3; ptr:3 = S; *:3 ptr = val20; }
macro popS20(ret20)  { ptr:3 = S; ret20 = *:3 ptr; S = S + 3; }

:PUSHU F    is F   & op0_8=0x2E { pushU8(F);   }
:POPU F     is F   & op0_8=0x3E { popU8(F);    }
:PUSHU IMR  is IMR & op0_8=0x2F { pushU8(IMR); }
:POPU IMR   is IMR & op0_8=0x3F { popU8(IMR);  }

:PUSHU R8L  is op3_5=0x05 & R8L  { pushU8(R8L);   }
:POPU R8L   is op3_5=0x07 & R8L  { popU8(R8L);    }
:PUSHU R16L is op3_5=0x05 & R16L { pushU16(R16L); }
:POPU R16L  is op3_5=0x07 & R16L { popU16(R16L);  }
:PUSHU R20L is op3_5=0x05 & R20L { pushU20(R20L); }
:POPU R20L  is op3_5=0x07 & R20L { popU20(R20L);  }

:PUSHS F is F & op0_8=0x4F { pushS8(F); }
:POPS F  is F & op0_8=0x5F { popS8(F);  }

### JUMP Command

:JR RelAddrFwd8 is op0_8=0x12; RelAddrFwd8 { goto RelAddrFwd8; }
:JR RelAddrBack8 is op0_8=0x13; RelAddrBack8 { goto RelAddrBack8; }
:JRZ RelAddrFwd8 is op0_8=0x18; RelAddrFwd8 { if (Z) goto RelAddrFwd8; }
:JRZ RelAddrBack8 is op0_8=0x19; RelAddrBack8 { if (Z) goto RelAddrBack8; }
:JRNZ RelAddrFwd8 is op0_8=0x1A; RelAddrFwd8 { if (!Z) goto RelAddrFwd8; }
:JRNZ RelAddrBack8 is op0_8=0x1B; RelAddrBack8 { if (!Z) goto RelAddrBack8; }
:JRC RelAddrFwd8 is op0_8=0x1C; RelAddrFwd8 { if (C) goto RelAddrFwd8; }
:JRC RelAddrBack8 is op0_8=0x1D; RelAddrBack8 { if (C) goto RelAddrBack8; }
:JRNC RelAddrFwd8 is op0_8=0x1E; RelAddrFwd8 { if (!C) goto RelAddrFwd8; }
:JRNC RelAddrBack8 is op0_8=0x1F; RelAddrBack8 { if (!C) goto RelAddrBack8; }

:JP Addr16 is op0_8=0x02; Addr16 { goto Addr16; }
:JPZ Addr16 is op0_8=0x14; Addr16 { if (Z) goto Addr16; }
:JPNZ Addr16 is op0_8=0x15; Addr16 { if (!Z) goto Addr16; }
:JPC Addr16 is op0_8=0x16; Addr16 { if (C) goto Addr16; }
:JPNC Addr16 is op0_8=0x17; Addr16 { if (!C) goto Addr16; }

:JPF Addr20 is op0_8=0x03; Addr20 { goto Addr20; }
:JP R20L is op0_8=0x11; op3_5=0x00 & R20L { goto [R20L]; }

:JP IntBP20 is op0_8=0x10; IntBP20 { goto [IntBP20]; }
:JP IntN20 is op0_8=0x30; op0_8=0x10; IntN20 { goto [IntN20]; }
:JP IntPX20 is op0_8=0x34; op0_8=0x10; IntPX20 { goto [IntPX20]; }
:JP IntBPPX20 is op0_8=0x24; op0_8=0x10; IntBPPX20 { goto [IntBPPX20]; }

### CALL RETURN command

:CALL Addr16 is op0_8=0x04; Addr16 { pushS16(&:2 inst_next); call Addr16; }
:CALLF Addr20 is op0_8=0x05; Addr20 { pushS20(&:3 inst_next); call Addr20; }
:RET is op0_8=0x06 { popS16(PC); return [FPC]; }
:RETF is op0_8=0x07 { popS20(FPC); return [FPC]; }

### RESET INTERRUPT Command

:RESET is op0_8=0xFF { goto [RESET_VECT];  }
:INT   is op0_8=0xFE { pushS20(&:3 inst_next); pushS8(F); pushS8(IMR); call [INT_VECT]; }
:RETI  is op0_8=0x01 { popS8(IMR); popS8(F); popS20(FPC); return [FPC]; }

### CPU Control Command

define pcodeop nop;
define pcodeop tcl;
define pcodeop halt;
define pcodeop off;

:WAIT is op0_8=0xEF { I = I - 1; if (I != 0) goto inst_start; }
:NOP  is op0_8=0x00 { nop(); }
:TCL  is op0_8=0xCE { tcl(); }
:HALT is op0_8=0xDE { halt(); }
:OFF  is op0_8=0xDF { off(); }
