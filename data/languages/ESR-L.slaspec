# mvp [--r20],(int)

:MVP MemRegIncDec24,IntN24    is op0_8=0x30; op0_8=0xEA; MemRegIncDec24; IntN24    { MemRegIncDec24 = IntN24;    }
:MVP MemRegIncDec24,IntBP24   is             op0_8=0xEA; MemRegIncDec24; IntBP24   { MemRegIncDec24 = IntBP24;   }
:MVP MemRegIncDec24,IntPX24   is op0_8=0x34; op0_8=0xEA; MemRegIncDec24; IntPX24   { MemRegIncDec24 = IntPX24;   }
:MVP MemRegIncDec24,IntBPPX24 is op0_8=0x24; op0_8=0xEA; MemRegIncDec24; IntBPPX24 { MemRegIncDec24 = IntBPPX24; }

# mvp [r20+off],(int)

:MVP [R20L+off8],IntN24    is op0_8=0x30; op0_8=0xEA; op3_5=0b10000 & R20L; IntN24;    off8 { wr24(R20L+off8, IntN24);    }
:MVP [R20L+off8],IntBP24   is             op0_8=0xEA; op3_5=0b10000 & R20L; IntBP24;   off8 { wr24(R20L+off8, IntBP24);   }
:MVP [R20L+off8],IntPX24   is op0_8=0x34; op0_8=0xEA; op3_5=0b10000 & R20L; IntPX24;   off8 { wr24(R20L+off8, IntPX24);   }
:MVP [R20L+off8],IntBPPX24 is op0_8=0x24; op0_8=0xEA; op3_5=0b10000 & R20L; IntBPPX24; off8 { wr24(R20L+off8, IntBPPX24); }

:MVP [R20L-off8],IntN24    is op0_8=0x30; op0_8=0xEA; op3_5=0b11000 & R20L; IntN24;    off8 { wr24(R20L-off8, IntN24);    }
:MVP [R20L-off8],IntBP24   is             op0_8=0xEA; op3_5=0b11000 & R20L; IntBP24;   off8 { wr24(R20L-off8, IntBP24);   }
:MVP [R20L-off8],IntPX24   is op0_8=0x34; op0_8=0xEA; op3_5=0b11000 & R20L; IntPX24;   off8 { wr24(R20L-off8, IntPX24);   }
