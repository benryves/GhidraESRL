# mv r8,[imm20]

:MV R8L,Ext8 is op3_5=0x11 & R8L; Ext8 { R8L = Ext8; }

# mv (int),[imm20]

:MV IntN8,Ext8    is op0_8=0x30; op0_8=0xD0; IntN8;    Ext8 { IntN8 = Ext8;    }
:MV IntBP8,Ext8   is             op0_8=0xD0; IntBP8;   Ext8 { IntBP8 = Ext8;   }
:MV IntPX8,Ext8   is op0_8=0x34; op0_8=0xD0; IntPX8;   Ext8 { IntPX8 = Ext8;   }
:MV IntBPPX8,Ext8 is op0_8=0x24; op0_8=0xD0; IntBPPX8; Ext8 { IntBPPX8 = Ext8; }

# mv r8,[r20]

:MV R8L,Ptr8 is op3_5=0b10010 & R8L; op3_5=0b00000 & Ptr8 { R8L = Ptr8; }

# mv (int),[r20]

:MV IntN8,Ptr8    is op0_8=0x30; op0_8=0xE0; op3_5=0b0000 & Ptr8; IntN8    { IntN8 = Ptr8;    }
:MV IntBP8,Ptr8   is             op0_8=0xE0; op3_5=0b0000 & Ptr8; IntBP8   { IntBP8 = Ptr8;   }
:MV IntPX8,Ptr8   is op0_8=0x34; op0_8=0xE0; op3_5=0b0000 & Ptr8; IntPX8   { IntPX8 = Ptr8;   }
:MV IntBPPX8,Ptr8 is op0_8=0x24; op0_8=0xE0; op3_5=0b0000 & Ptr8; IntBPPX8 { IntBPPX8 = Ptr8; }

