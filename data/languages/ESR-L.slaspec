:MVP [IntBPPX20],IntBP24   is op0_8=0x24; op0_8=0xFA; op0_8=0x00; IntBPPX20; IntBP24   { wr24(IntBPPX20, IntBP24);   }
:MVP [IntN20],IntPY24      is op0_8=0x33; op0_8=0xFA; op0_8=0x00; IntN20;    IntPY24   { wr24(IntN20, IntPY24);      }
:MVP [IntBP20],IntPY24     is op0_8=0x23; op0_8=0xFA; op0_8=0x00; IntBP20;   IntPY24   { wr24(IntBP20, IntPY24);     }
:MVP [IntPX20],IntPY24     is op0_8=0x37; op0_8=0xFA; op0_8=0x00; IntPX20;   IntPY24   { wr24(IntPX20, IntPY24);     }
:MVP [IntBPPX20],IntPY24   is op0_8=0x27; op0_8=0xFA; op0_8=0x00; IntBPPX20; IntPY24   { wr24(IntBPPX20, IntPY24);   }
:MVP [IntN20],IntBPPY24    is op0_8=0x31; op0_8=0xFA; op0_8=0x00; IntN20;    IntBPPY24 { wr24(IntN20, IntBPPY24);    }
:MVP [IntBP20],IntBPPY24   is op0_8=0x21; op0_8=0xFA; op0_8=0x00; IntBP20;   IntBPPY24 { wr24(IntBP20, IntBPPY24);   }
:MVP [IntPX20],IntBPPY24   is op0_8=0x35; op0_8=0xFA; op0_8=0x00; IntPX20;   IntBPPY24 { wr24(IntPX20, IntBPPY24);   }
:MVP [IntBPPX20],IntBPPY24 is op0_8=0x25; op0_8=0xFA; op0_8=0x00; IntBPPX20; IntBPPY24 { wr24(IntBPPX20, IntBPPY24); }

