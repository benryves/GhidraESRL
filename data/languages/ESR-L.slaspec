# sleigh specification file for Sharp ESR-L

define endian=little;
define alignment=1;

define space register  type=register_space  size=1;
define space ram       type=ram_space       size=3 default;

define register offset=0x10 size=2 [ BA I ];
define register offset=0x10 size=1 [ B A IH IL ];

define register offset=0x20 size=3 [ X Y U S ];

define register offset=0x30 size=4 [ FPC ];
define register offset=0x30 size=2 [ _ PC ];
define register offset=0x30 size=1 [ PS _ _ ];

define register offset=0x40 size=1 [ F ];
define bitrange C = F[0,1] Z = F[1,1];

define ram offset=0xEC size=1 [ BP PX PY AMC KOL KOH KI EOL EOH EIL EIH UCR USR RXD TXD IMR ISR SCR LCC SSR ];

define ram offset=0xFFFFA size=3 [ INT_VECT RESET_VECT ];

define token opbyte (8)
	op0_8        = (0,7)
	op3_5        = (3,7)
	reg1_2       = (1,2)
	reg2_1       = (2,2)
	reg1_3       = (1,3)
	reg5_3       = (5,7)
	reg5_2       = (5,6)
	reg0_3_r8    = (0,2)
	reg0_3_r16   = (0,2)
	reg0_3_r20   = (0,2)
	reg0_3_r20_2 = (0,2)
	reg4_3_r8    = (4,6)
	reg4_3_r16   = (4,6)
	reg4_3_r20   = (4,6)
;

define token data8 (8)
	imm8  = (0,7)
	sign8 = (7,7)
	simm8 = (0,7) signed
	off8  = (0,7)
;

define token data16 (16)
	imm16  = (0,15)
;

define token data24 (24)
	imm20  = (0,19)
;

attach variables [ reg0_3_r8 reg4_3_r8 ] [ A IL _ _ _ _ _ _ ];
attach variables [ reg0_3_r16 reg4_3_r16 ] [ _ _ BA I _ _ _ _ ];
attach variables [ reg0_3_r20 reg0_3_r20_2 reg4_3_r20 ] [ _ _ _ _ X Y U S ];

# Registers in the low nybble
R8L: reg0_3_r8 is reg0_3_r8 & reg1_2=0 { export reg0_3_r8; }
R16L: reg0_3_r16 is reg0_3_r16 & reg1_2=1 { export reg0_3_r16; }
R20L: reg0_3_r20 is reg0_3_r20 & reg1_2>1 { export reg0_3_r20; }
XYUL: reg0_3_r20 is reg0_3_r20 & reg1_2>1 & reg0_3_r20_2 < 7 { export reg0_3_r20; }

# Registers in the high nybble
R8H: reg4_3_r8 is reg4_3_r8 & reg5_2=0 { export reg4_3_r8; }
R16H: reg4_3_r16 is reg4_3_r16 & reg5_2=1 { export reg4_3_r16; }
R20H: reg4_3_r20 is reg4_3_r20 & reg5_2>1 { export reg4_3_r20; }

Addr16: loc is imm16 [ loc = (inst_start & 0xF0000) | imm16; ] { export *:1 loc; }
Addr20: loc is imm20 [ loc = imm20 & 0xFFFFF; ] { export *:1 loc; }
RelAddrFwd8: loc is imm8 [ loc = (inst_next + imm8) & 0xFFFFF; ] { export *:1 loc; }
RelAddrBack8: loc is imm8 [ loc = (inst_next - imm8) & 0xFFFFF; ] { export *:1 loc; }

# 20-bit immediate values that reference external memory directly
Ext8:  [loc] is imm20 [ loc = imm20 & 0xFFFFF; ] { export *:1 loc; }
Ext16: [loc] is imm20 [ loc = imm20 & 0xFFFFF; ] { export *:2 loc; }
Ext24: [loc] is imm20 [ loc = imm20 & 0xFFFFF; ] { export *:3 loc; }

# 20-bit registers (X, Y, U, S) used as pointers to external memory
Ptr8: [R20L] is R20L { export *:1 R20L; }
Ptr16: [R20L] is R20L { export *:2 R20L; }
Ptr20: [R20L] is R20L { export *:3 R20L; }
Ptr24: [R20L] is R20L { export *:3 R20L; }

IntN8: (imm8) is imm8 { export *:1 imm8; }
IntN8_2: (imm8) is imm8 { export *:1 imm8; }
IntBP8: (BP+simm8) is BP & simm8 { tmp = BP + simm8; export *:1 tmp; }
IntBP8: (BP-val) is BP & simm8 & sign8=1 [ val = -simm8; ] { tmp = BP + simm8; export *:1 tmp; }
IntBP8_2: (BP+simm8) is BP & simm8 { tmp = BP + simm8; export *:1 tmp; }
IntBP8_2: (BP-val) is BP & simm8 & sign8=1 [ val = -simm8; ] { tmp = BP + simm8; export *:1 tmp; }
IntBPPX8: (BP+PX) is BP & PX & op0_8 { tmp = BP + PX; export *:1 tmp; }
IntBPPY8: (BP+PY) is BP & PY & op0_8 { tmp = BP + PY; export *:1 tmp; }
IntPX8: (PX+simm8) is PX & simm8 { tmp = PX + simm8; export *:1 tmp; }
IntPX8: (PX-val) is PX & simm8 & sign8=1 [ val = -simm8; ] { tmp = PX + simm8; export *:1 tmp; }
IntPY8: (PY+simm8) is PY & simm8 { tmp = PY + simm8; export *:1 tmp; }
IntPY8: (PY-val) is PY & simm8 & sign8=1 [ val = -simm8; ] { tmp = PY + simm8; export *:1 tmp; }

IntN16: (imm8) is imm8 { export *:2 imm8; }
IntN16_2: (imm8) is imm8 { export *:2 imm8; }
IntBP16: (BP+simm8) is BP & simm8 { tmp = BP + simm8; export *:2 tmp; }
IntBP16: (BP-val) is BP & simm8 & sign8=1 [ val = -simm8; ] { tmp = BP + simm8; export *:2 tmp; }
IntBP16_2: (BP+simm8) is BP & simm8 { tmp = BP + simm8; export *:2 tmp; }
IntBP16_2: (BP-val) is BP & simm8 & sign8=1 [ val = -simm8; ] { tmp = BP + simm8; export *:2 tmp; }
IntBPPX16: (BP+PX) is BP & PX & op0_8 { tmp = BP + PX; export *:2 tmp; }
IntBPPY16: (BP+PY) is BP & PY & op0_8 { tmp = BP + PY; export *:2 tmp; }
IntPX16: (PX+simm8) is PX & simm8 { tmp = PX + simm8; export *:2 tmp; }
IntPX16: (PX-val) is PX & simm8 & sign8=1 [ val = -simm8; ] { tmp = PX + simm8; export *:2 tmp; }
IntPY16: (PY+simm8) is PY & simm8 { tmp = PY + simm8; export *:2 tmp; }
IntPY16: (PY-val) is PY & simm8 & sign8=1 [ val = -simm8; ] { tmp = PY + simm8; export *:2 tmp; }

IntN20: (imm8) is imm8 { export *:3 imm8; }
IntBP20: (BP+simm8) is BP & simm8 { tmp = BP + simm8; export *:3 tmp; }
IntBP20: (BP-val) is BP & simm8 & sign8=1 [ val = -simm8; ] { tmp = BP + simm8; export *:3 tmp; }
IntBPPX20: (BP+PX) is BP & PX & op0_8 { tmp = BP + PX; export *:3 tmp; }
IntBPPY20: (BP+PY) is BP & PY & op0_8 { tmp = BP + PY; export *:3 tmp; }
IntPX20: (PX+simm8) is PX & simm8 { tmp = PX + simm8; export *:3 tmp; }
IntPX20: (PX-val) is PX & simm8 & sign8=1 [ val = -simm8; ] { tmp = PX + simm8; export *:3 tmp; }
IntPY20: (PY+simm8) is PY & simm8 { tmp = PY + simm8; export *:3 tmp; }
IntPY20: (PY-val) is PY & simm8 & sign8=1 [ val = -simm8; ] { tmp = PY + simm8; export *:3 tmp; }

IntN24: (imm8) is imm8 { export *:3 imm8; }
IntN24_2: (imm8) is imm8 { export *:3 imm8; }
IntBP24: (BP+simm8) is BP & simm8 { tmp = BP + simm8; export *:3 tmp; }
IntBP24: (BP-val) is BP & simm8 & sign8=1 [ val = -simm8; ] { tmp = BP + simm8; export *:3 tmp; }
IntBP24_2: (BP+simm8) is BP & simm8 { tmp = BP + simm8; export *:3 tmp; }
IntBP24_2: (BP-val) is BP & simm8 & sign8=1 [ val = -simm8; ] { tmp = BP + simm8; export *:3 tmp; }
IntBPPX24: (BP+PX) is BP & PX & op0_8 { tmp = BP + PX; export *:3 tmp; }
IntBPPY24: (BP+PY) is BP & PY & op0_8 { tmp = BP + PY; export *:3 tmp; }
IntPX24: (PX+simm8) is PX & simm8 { tmp = PX + simm8; export *:3 tmp; }
IntPX24: (PX-val) is PX & simm8 & sign8=1 [ val = -simm8; ] { tmp = PX + simm8; export *:3 tmp; }
IntPY24: (PY+simm8) is PY & simm8 { tmp = PY + simm8; export *:3 tmp; }
IntPY24: (PY-val) is PY & simm8 & sign8=1 [ val = -simm8; ] { tmp = PY + simm8; export *:3 tmp; }

IntNAddr: (imm8) is imm8 { tmp:3 = imm8; export tmp; }
IntNAddr_2: (imm8) is imm8 { tmp:3 = imm8; export tmp; }
IntBPAddr: (BP+simm8) is BP & simm8 { tmp:3 = zext(BP + simm8) & 0xFF; export tmp; }
IntBPAddr: (BP-val) is BP & simm8 & sign8=1 [ val = -simm8; ] { tmp:3 = zext(BP + simm8) & 0xFF; export tmp; }
IntBPAddr_2: (BP+simm8) is BP & simm8 { tmp:3 = zext(BP + simm8) & 0xFF; export tmp; }
IntBPAddr_2: (BP-val) is BP & simm8 & sign8=1 [ val = -simm8; ] { tmp:3 = zext(BP + simm8) & 0xFF; export tmp; }
IntBPPXAddr: (BP+PX) is BP & PX & op0_8 { tmp:3 = zext(BP + PX) & 0xFF; export tmp; }
IntBPPYAddr: (BP+PY) is BP & PY & op0_8 { tmp:3 = zext(BP + PY) & 0xFF; export tmp; }
IntPXAddr: (PX+simm8) is PX & simm8 { tmp:3 = zext(PX + simm8) & 0xFF; export tmp; }
IntPXAddr: (PX-val) is PX & simm8 & sign8=1 [ val = -simm8; ] { tmp:3 = zext(PX + simm8) & 0xFF; export tmp; }
IntPYAddr: (PY+simm8) is PY & simm8 { tmp:3 = zext(PY + simm8) * 0xFF; export tmp; }
IntPYAddr: (PY-val) is PY & simm8 & sign8=1 [ val = -simm8; ] { tmp:3 = zext(PY + simm8) & 0xFF; export tmp; }

MemRegIncDec8: [reg0_3_r20++] is reg0_3_r20 & op3_5=0b00100 { tmp = reg0_3_r20; reg0_3_r20 = reg0_3_r20 + 1; export *:1 tmp; }
MemRegIncDec8: [--reg0_3_r20] is reg0_3_r20 & op3_5=0b00110 { reg0_3_r20 = reg0_3_r20 - 1; tmp = reg0_3_r20; export *:1 tmp; }

MemRegIncDec16: [reg0_3_r20++] is reg0_3_r20 & op3_5=0b00100 { tmp = reg0_3_r20; reg0_3_r20 = reg0_3_r20 + 2; export *:2 tmp; }
MemRegIncDec16: [--reg0_3_r20] is reg0_3_r20 & op3_5=0b00110 { reg0_3_r20 = reg0_3_r20 - 2; tmp = reg0_3_r20; export *:2 tmp; }

MemRegIncDec20: [reg0_3_r20++] is reg0_3_r20 & op3_5=0b00100 { tmp = reg0_3_r20; reg0_3_r20 = reg0_3_r20 + 3; export *:3 tmp; }
MemRegIncDec20: [--reg0_3_r20] is reg0_3_r20 & op3_5=0b00110 { reg0_3_r20 = reg0_3_r20 - 3; tmp = reg0_3_r20; export *:3 tmp; }

MemRegIncDec24: [reg0_3_r20++] is reg0_3_r20 & op3_5=0b00100 { tmp = reg0_3_r20; reg0_3_r20 = reg0_3_r20 + 3; export *:3 tmp; }
MemRegIncDec24: [--reg0_3_r20] is reg0_3_r20 & op3_5=0b00110 { reg0_3_r20 = reg0_3_r20 - 3; tmp = reg0_3_r20; export *:3 tmp; }

MemRegInc: [reg0_3_r20++] is reg0_3_r20 & op3_5=0b00100 { export *:3 reg0_3_r20; }
MemRegDec: [--reg0_3_r20] is reg0_3_r20 & op3_5=0b00110 { export *:3 reg0_3_r20; }


macro wr8(addr, val8) { ptr:3 = addr; *:1 ptr = val8; }
macro rd8(ret8, addr) { ptr:3 = addr; ret8 = *:1 ptr; }

macro wr16(addr, val16) { ptr:3 = addr; *:2 ptr = val16; }
macro rd16(ret16, addr) { ptr:3 = addr; ret16 = *:2 ptr; }

macro wr20(addr, val20) { ptr:3 = addr; *:3 ptr = val20; }
macro rd20(ret20, addr) { ptr:3 = addr; ret20 = *:3 ptr; }

macro wr24(addr, val24) { ptr:3 = addr; *:3 ptr = val24; }
macro rd24(ret24, addr) { ptr:3 = addr; ret24 = *:3 ptr; }

### 1 Byte Transmission Command No. 1

# mv r8,imm8

:MV R8L,imm8 is op3_5=0x01 & R8L; imm8 { R8L = imm8; }

# mv (int),imm8

:MV IntN8,imm8    is op0_8=0x30; op0_8=0xCC; IntN8;    imm8 { IntN8 = imm8; }
:MV IntBP8,imm8   is             op0_8=0xCC; IntBP8;   imm8 { IntBP8 = imm8; }
:MV IntPX8,imm8   is op0_8=0x34; op0_8=0xCC; IntPX8;   imm8 { IntPX8 = imm8; }
:MV IntBPPX8,imm8 is op0_8=0x24; op0_8=0xCC; IntBPPX8; imm8 { IntBPPX8 = imm8; }

# mv r8,r8

:MV R8H,R8L is op0_8=0xFD; R8H & R8L { R8H = R8L; }

# mv (int),r8

:MV IntN8,R8L    is op0_8=0x30; op3_5=0b10100 & R8L; IntN8    { IntN8 = R8L; }
:MV IntBP8,R8L   is             op3_5=0b10100 & R8L; IntBP8   { IntBP8 = R8L; }
:MV IntPX8,R8L   is op0_8=0x34; op3_5=0b10100 & R8L; IntPX8   { IntPX8 = R8L; }
:MV IntBPPX8,R8L is op0_8=0x24; op3_5=0b10100 & R8L; IntBPPX8 { IntBPPX8 = R8L; }

# mv [imm20],r8

:MV Ext8,R8L is op3_5=0b10101 & R8L; Ext8 { Ext8 = R8L; }

# mv [r20],r8

:MV Ptr8,R8L is op3_5=0b10110 & R8L; op3_5=0b00000 & Ptr8 { Ptr8 = R8L; }

# mv [r20++],r8
# mv [--r20],r8

:MV MemRegIncDec8,R8L is op3_5=0b10110 & R8L; MemRegIncDec8 { MemRegIncDec8 = R8L; }

# mv [r20+off],r8

:MV [R20L+off8],R8L is op3_5=0b10110 & R8L; op3_5=0b10000 & R20L; off8 { wr8(R20L + off8, R8L); }
:MV [R20L-off8],R8L is op3_5=0b10110 & R8L; op3_5=0b11000 & R20L; off8 { wr8(R20L - off8, R8L); }

# mv [(int)],r8

:MV [IntN20],R8L    is op0_8=0x30; op3_5=0b10111 & R8L; op0_8=0x00; IntN20    { wr8(IntN20, R8L);    }
:MV [IntBP20],R8L   is             op3_5=0b10111 & R8L; op0_8=0x00; IntBP20   { wr8(IntBP20, R8L);   }
:MV [IntPX20],R8L   is op0_8=0x34; op3_5=0b10111 & R8L; op0_8=0x00; IntPX20   { wr8(IntPX20, R8L);   }
:MV [IntBPPX20],R8L is op0_8=0x24; op3_5=0b10111 & R8L; op0_8=0x00; IntBPPX20 { wr8(IntBPPX20, R8L); }

# mv [(int)+off],r8

:MV [IntN20+off8],R8L    is op0_8=0x30; op3_5=0b10111 & R8L; op0_8=0x80; IntN20;    off8 { wr8(IntN20+off8, R8L);    }
:MV [IntBP20+off8],R8L   is             op3_5=0b10111 & R8L; op0_8=0x80; IntBP20;   off8 { wr8(IntBP20+off8, R8L);   }
:MV [IntPX20+off8],R8L   is op0_8=0x34; op3_5=0b10111 & R8L; op0_8=0x80; IntPX20;   off8 { wr8(IntPX20+off8, R8L);   }
:MV [IntBPPX20+off8],R8L is op0_8=0x24; op3_5=0b10111 & R8L; op0_8=0x80; IntBPPX20; off8 { wr8(IntBPPX20+off8, R8L); }

:MV [IntN20-off8],R8L    is op0_8=0x30; op3_5=0b10111 & R8L; op0_8=0xC0; IntN20;    off8 { wr8(IntN20-off8, R8L);    }
:MV [IntBP20-off8],R8L   is             op3_5=0b10111 & R8L; op0_8=0xC0; IntBP20;   off8 { wr8(IntBP20-off8, R8L);   }
:MV [IntPX20-off8],R8L   is op0_8=0x34; op3_5=0b10111 & R8L; op0_8=0xC0; IntPX20;   off8 { wr8(IntPX20-off8, R8L);   }
:MV [IntBPPX20-off8],R8L is op0_8=0x24; op3_5=0b10111 & R8L; op0_8=0xC0; IntBPPX20; off8 { wr8(IntBPPX20-off8, R8L); }

# mv r8,(int)

:MV R8L,IntN8    is op0_8=0x30; op3_5=0b10000 & R8L; IntN8    { R8L = IntN8; }
:MV R8L,IntBP8   is             op3_5=0b10000 & R8L; IntBP8   { R8L = IntBP8; }
:MV R8L,IntPX8   is op0_8=0x34; op3_5=0b10000 & R8L; IntPX8   { R8L = IntPX8; }
:MV R8L,IntBPPX8 is op0_8=0x24; op3_5=0b10000 & R8L; IntBPPX8 { R8L = IntBPPX8; }

# mv (int),(int)

:MV IntN8,IntN8_2     is op0_8=0x32; op0_8=0xC8; IntN8;    IntN8_2  { IntN8 = IntN8_2;     }
:MV IntBP8,IntN8      is op0_8=0x22; op0_8=0xC8; IntBP8;   IntN8    { IntBP8 = IntN8;      }
:MV IntPX8,IntN8      is op0_8=0x36; op0_8=0xC8; IntPX8;   IntN8    { IntPX8 = IntN8;      }
:MV IntBPPX8,IntN8    is op0_8=0x26; op0_8=0xC8; IntBPPX8; IntN8    { IntBPPX8 = IntN8;    }
:MV IntN8,IntBP8      is op0_8=0x30; op0_8=0xC8; IntN8;    IntBP8   { IntN8 = IntBP8;      }
:MV IntBP8,IntBP8_2   is             op0_8=0xC8; IntBP8;   IntBP8_2 { IntBP8 = IntBP8_2;   }
:MV IntPX8,IntBP8     is op0_8=0x34; op0_8=0xC8; IntPX8;   IntBP8   { IntPX8 = IntBP8;     }
:MV IntBPPX8,IntBP8   is op0_8=0x24; op0_8=0xC8; IntBPPX8; IntBP8   { IntBPPX8 = IntBP8;   }
:MV IntN8,IntPY8      is op0_8=0x33; op0_8=0xC8; IntN8;    IntPY8   { IntN8 = IntPY8;      }
:MV IntBP8,IntPY8     is op0_8=0x23; op0_8=0xC8; IntBP8;   IntPY8   { IntBP8 = IntPY8;     }
:MV IntPX8,IntPY8     is op0_8=0x37; op0_8=0xC8; IntPX8;   IntPY8   { IntPX8 = IntPY8;     }
:MV IntBPPX8,IntPY8   is op0_8=0x27; op0_8=0xC8; IntBPPX8; IntPY8   { IntBPPX8 = IntPY8;   }
:MV IntN8,IntBPPY8    is op0_8=0x31; op0_8=0xC8; IntN8;    IntBPPY8 { IntN8 = IntBPPY8;    }
:MV IntBP8,IntBPPY8   is op0_8=0x21; op0_8=0xC8; IntBP8;   IntBPPY8 { IntBP8 = IntBPPY8;   }
:MV IntPX8,IntBPPY8   is op0_8=0x35; op0_8=0xC8; IntPX8;   IntBPPY8 { IntPX8 = IntBPPY8;   }
:MV IntBPPX8,IntBPPY8 is op0_8=0x25; op0_8=0xC8; IntBPPX8; IntBPPY8 { IntBPPX8 = IntBPPY8; }

# mv [imm20],(int)

:MV Ext8,IntBP8   is             op0_8=0xD8; Ext8; IntBP8   { Ext8 = IntBP8;   }
:MV Ext8,IntN8    is op0_8=0x30; op0_8=0xD8; Ext8; IntN8    { Ext8 = IntN8;    }
:MV Ext8,IntPX8   is op0_8=0x34; op0_8=0xD8; Ext8; IntPX8   { Ext8 = IntPX8;   }
:MV Ext8,IntBPPX8 is op0_8=0x24; op0_8=0xD8; Ext8; IntBPPX8 { Ext8 = IntBPPX8; }

# mv [r20],(int)

:MV Ptr8,IntN8    is op0_8=0x30; op0_8=0xE8; op3_5=0b00000 & Ptr8; IntN8    { Ptr8 = IntN8;    }
:MV Ptr8,IntBP8   is             op0_8=0xE8; op3_5=0b00000 & Ptr8; IntBP8   { Ptr8 = IntBP8;   }
:MV Ptr8,IntPX8   is op0_8=0x34; op0_8=0xE8; op3_5=0b00000 & Ptr8; IntPX8   { Ptr8 = IntPX8;   }
:MV Ptr8,IntBPPX8 is op0_8=0x24; op0_8=0xE8; op3_5=0b00000 & Ptr8; IntBPPX8 { Ptr8 = IntBPPX8; }

# mv [r20++],(int)
# mv [--r20],(int)

:MV MemRegIncDec8,IntN8    is op0_8=0x30; op0_8=0xE8; MemRegIncDec8; IntN8    { MemRegIncDec8 = IntN8;    }
:MV MemRegIncDec8,IntBP8   is             op0_8=0xE8; MemRegIncDec8; IntBP8   { MemRegIncDec8 = IntBP8;   }
:MV MemRegIncDec8,IntPX8   is op0_8=0x34; op0_8=0xE8; MemRegIncDec8; IntPX8   { MemRegIncDec8 = IntPX8;   }
:MV MemRegIncDec8,IntBPPX8 is op0_8=0x24; op0_8=0xE8; MemRegIncDec8; IntBPPX8 { MemRegIncDec8 = IntBPPX8; }

# mv [r20+off],(int)

:MV [R20L+off8],IntN8    is op0_8=0x30; op0_8=0xE8; op3_5=0b10000 & R20L; IntN8;    off8 { tmp = R20L + off8; *:1 tmp = IntN8;    }
:MV [R20L+off8],IntBP8   is             op0_8=0xE8; op3_5=0b10000 & R20L; IntBP8;   off8 { tmp = R20L + off8; *:1 tmp = IntBP8;   }
