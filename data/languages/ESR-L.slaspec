:MVP [IntN20+off8],IntBP24      is op0_8=0x30; op0_8=0xFA; op0_8=0x80; IntN20;    IntBP24;   off8 { wr24(IntN20+off8, IntBP24);      }
:MVP [IntBP20+off8],IntBP24     is             op0_8=0xFA; op0_8=0x80; IntBP20;   IntBP24;   off8 { wr24(IntBP20+off8, IntBP24);     }
