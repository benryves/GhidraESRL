:MVW MemRegIncDec16,IntN16    is op0_8=0x30; op0_8=0xE9; MemRegIncDec16; IntN16    { MemRegIncDec16 = IntN16;    }
:MVW MemRegIncDec16,IntBP16   is             op0_8=0xE9; MemRegIncDec16; IntBP16   { MemRegIncDec16 = IntBP16;   }
:MVW MemRegIncDec16,IntPX16   is op0_8=0x34; op0_8=0xE9; MemRegIncDec16; IntPX16   { MemRegIncDec16 = IntPX16;   }
:MVW MemRegIncDec16,IntBPPX16 is op0_8=0x24; op0_8=0xE9; MemRegIncDec16; IntBPPX16 { MemRegIncDec16 = IntBPPX16; }

# mvw [r20+off],(int)

:MVW [R20L+off8],IntN16    is op0_8=0x30; op0_8=0xE9; op3_5=0b10000 & R20L; IntN16;    off8 { wr16(R20L+off8, IntN16);    }
:MVW [R20L+off8],IntBP16   is             op0_8=0xE9; op3_5=0b10000 & R20L; IntBP16;   off8 { wr16(R20L+off8, IntBP16);   }
:MVW [R20L+off8],IntPX16   is op0_8=0x34; op0_8=0xE9; op3_5=0b10000 & R20L; IntPX16;   off8 { wr16(R20L+off8, IntPX16);   }
:MVW [R20L+off8],IntBPPX16 is op0_8=0x24; op0_8=0xE9; op3_5=0b10000 & R20L; IntBPPX16; off8 { wr16(R20L+off8, IntBPPX16); }

:MVW [R20L-off8],IntN16    is op0_8=0x30; op0_8=0xE9; op3_5=0b11000 & R20L; IntN16;    off8 { wr16(R20L-off8, IntN16);    }
:MVW [R20L-off8],IntBP16   is             op0_8=0xE9; op3_5=0b11000 & R20L; IntBP16;   off8 { wr16(R20L-off8, IntBP16);   }
:MVW [R20L-off8],IntPX16   is op0_8=0x34; op0_8=0xE9; op3_5=0b11000 & R20L; IntPX16;   off8 { wr16(R20L-off8, IntPX16);   }
:MVW [R20L-off8],IntBPPX16 is op0_8=0x24; op0_8=0xE9; op3_5=0b11000 & R20L; IntBPPX16; off8 { wr16(R20L-off8, IntBPPX16); }

