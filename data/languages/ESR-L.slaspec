:MVW [IntBP20+off8],IntPY16     is op0_8=0x23; op0_8=0xF9; op0_8=0x80; IntBP20;   IntPY16;   off8 { wr16(IntBP20+off8, IntPY16);     }
:MVW [IntPX20+off8],IntPY16     is op0_8=0x37; op0_8=0xF9; op0_8=0x80; IntPX20;   IntPY16;   off8 { wr16(IntPX20+off8, IntPY16);     }
:MVW [IntBPPX20+off8],IntPY16   is op0_8=0x27; op0_8=0xF9; op0_8=0x80; IntBPPX20; IntPY16;   off8 { wr16(IntBPPX20+off8, IntPY16);   }
:MVW [IntN20+off8],IntBPPY16    is op0_8=0x31; op0_8=0xF9; op0_8=0x80; IntN20;    IntBPPY16; off8 { wr16(IntN20+off8, IntBPPY16);    }
:MVW [IntBP20+off8],IntBPPY16   is op0_8=0x21; op0_8=0xF9; op0_8=0x80; IntBP20;   IntBPPY16; off8 { wr16(IntBP20+off8, IntBPPY16);   }
:MVW [IntPX20+off8],IntBPPY16   is op0_8=0x35; op0_8=0xF9; op0_8=0x80; IntPX20;   IntBPPY16; off8 { wr16(IntPX20+off8, IntBPPY16);   }
:MVW [IntBPPX20+off8],IntBPPY16 is op0_8=0x25; op0_8=0xF9; op0_8=0x80; IntBPPX20; IntBPPY16; off8 { wr16(IntBPPX20+off8, IntBPPY16); }

:MVW [IntN20-off8],IntN16       is op0_8=0x32; op0_8=0xF9; op0_8=0xC0; IntN20;    IntN16;    off8 { wr16(IntN20-off8, IntN16);       }
:MVW [IntBP20-off8],IntN16      is op0_8=0x22; op0_8=0xF9; op0_8=0xC0; IntBP20;   IntN16;    off8 { wr16(IntBP20-off8, IntN16);      }
:MVW [IntPX20-off8],IntN16      is op0_8=0x36; op0_8=0xF9; op0_8=0xC0; IntPX20;   IntN16;    off8 { wr16(IntPX20-off8, IntN16);      }
:MVW [IntBPPX20-off8],IntN16    is op0_8=0x26; op0_8=0xF9; op0_8=0xC0; IntBPPX20; IntN16;    off8 { wr16(IntBPPX20-off8, IntN16);    }
:MVW [IntN20-off8],IntBP16      is op0_8=0x30; op0_8=0xF9; op0_8=0xC0; IntN20;    IntBP16;   off8 { wr16(IntN20-off8, IntBP16);      }
:MVW [IntBP20-off8],IntBP16     is             op0_8=0xF9; op0_8=0xC0; IntBP20;   IntBP16;   off8 { wr16(IntBP20-off8, IntBP16);     }
:MVW [IntPX20-off8],IntBP16     is op0_8=0x34; op0_8=0xF9; op0_8=0xC0; IntPX20;   IntBP16;   off8 { wr16(IntPX20-off8, IntBP16);     }
:MVW [IntBPPX20-off8],IntBP16   is op0_8=0x24; op0_8=0xF9; op0_8=0xC0; IntBPPX20; IntBP16;   off8 { wr16(IntBPPX20-off8, IntBP16);   }
:MVW [IntN20-off8],IntPY16      is op0_8=0x33; op0_8=0xF9; op0_8=0xC0; IntN20;    IntPY16;   off8 { wr16(IntN20-off8, IntPY16);      }
:MVW [IntBP20-off8],IntPY16     is op0_8=0x23; op0_8=0xF9; op0_8=0xC0; IntBP20;   IntPY16;   off8 { wr16(IntBP20-off8, IntPY16);     }
:MVW [IntPX20-off8],IntPY16     is op0_8=0x37; op0_8=0xF9; op0_8=0xC0; IntPX20;   IntPY16;   off8 { wr16(IntPX20-off8, IntPY16);     }
:MVW [IntBPPX20-off8],IntPY16   is op0_8=0x27; op0_8=0xF9; op0_8=0xC0; IntBPPX20; IntPY16;   off8 { wr16(IntBPPX20-off8, IntPY16);   }
:MVW [IntN20-off8],IntBPPY16    is op0_8=0x31; op0_8=0xF9; op0_8=0xC0; IntN20;    IntBPPY16; off8 { wr16(IntN20-off8, IntBPPY16);    }
:MVW [IntBP20-off8],IntBPPY16   is op0_8=0x21; op0_8=0xF9; op0_8=0xC0; IntBP20;   IntBPPY16; off8 { wr16(IntBP20-off8, IntBPPY16);   }
:MVW [IntPX20-off8],IntBPPY16   is op0_8=0x35; op0_8=0xF9; op0_8=0xC0; IntPX20;   IntBPPY16; off8 { wr16(IntPX20-off8, IntBPPY16);   }
:MVW [IntBPPX20-off8],IntBPPY16 is op0_8=0x25; op0_8=0xF9; op0_8=0xC0; IntBPPX20; IntBPPY16; off8 { wr16(IntBPPX20-off8, IntBPPY16); }

# mv r16,[imm20]

:MV R16L,Ext16 is op3_5=0x11 & R16L; Ext16 { R16L = Ext16; }

# mvw (int),[imm20]

:MVW IntN16,Ext16    is op0_8=0x30; op0_8=0xD1; IntN16;    Ext16 { IntN16 = Ext16;    }
:MVW IntBP16,Ext16   is             op0_8=0xD1; IntBP16;   Ext16 { IntBP16 = Ext16;   }
:MVW IntPX16,Ext16   is op0_8=0x34; op0_8=0xD1; IntPX16;   Ext16 { IntPX16 = Ext16;   }
:MVW IntBPPX16,Ext16 is op0_8=0x24; op0_8=0xD1; IntBPPX16; Ext16 { IntBPPX16 = Ext16; }

# mv r16,[r20]

:MV R16L,Ptr16 is op3_5=0b10010 & R16L; op3_5=0b00000 & Ptr16 { R16L = Ptr16; }

# mvw (int),[r20]

:MVW IntN16,Ptr16    is op0_8=0x30; op0_8=0xE1; op3_5=0b0000 & Ptr16; IntN16    { IntN16 = Ptr16;    }
:MVW IntBP16,Ptr16   is             op0_8=0xE1; op3_5=0b0000 & Ptr16; IntBP16   { IntBP16 = Ptr16;   }
:MVW IntPX16,Ptr16   is op0_8=0x34; op0_8=0xE1; op3_5=0b0000 & Ptr16; IntPX16   { IntPX16 = Ptr16;   }
:MVW IntBPPX16,Ptr16 is op0_8=0x24; op0_8=0xE1; op3_5=0b0000 & Ptr16; IntBPPX16 { IntBPPX16 = Ptr16; }

