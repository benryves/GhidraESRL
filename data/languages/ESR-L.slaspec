:MVP [IntN20-off8],IntPY24      is op0_8=0x33; op0_8=0xFA; op0_8=0xC0; IntN20;    IntPY24;   off8 { wr24(IntN20-off8, IntPY24);      }
:MVP [IntBP20-off8],IntPY24     is op0_8=0x23; op0_8=0xFA; op0_8=0xC0; IntBP20;   IntPY24;   off8 { wr24(IntBP20-off8, IntPY24);     }
