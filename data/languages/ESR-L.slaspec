### 3 Byte Transmission Command No. 1

# mv r20,imm20

:MV R20L,imm20 is op3_5=0x01 & R20L; imm20 { R20L = imm20; }

# mvp (int),imm20

:MVP IntN24,imm20    is op0_8=0x30; op0_8=0xDC; IntN24;    imm20 { IntN24 = imm20;    }
:MVP IntBP24,imm20   is             op0_8=0xDC; IntBP24;   imm20 { IntBP24 = imm20;   }
:MVP IntPX24,imm20   is op0_8=0x34; op0_8=0xDC; IntPX24;   imm20 { IntPX24 = imm20;   }
:MVP IntBPPX24,imm20 is op0_8=0x24; op0_8=0xDC; IntBPPX24; imm20 { IntBPPX24 = imm20; }

# mv r20,r20

:MV R20H,R20L is op0_8=0xFD; R20H & R20L { R20H = R20L; }

# mv (int),r20

:MV IntN24,R20L    is op0_8=0x30; op3_5=0b10100 & R20L; IntN24    { IntN24 = R20L;    }
:MV IntBP24,R20L   is             op3_5=0b10100 & R20L; IntBP24   { IntBP24 = R20L;   }
:MV IntPX24,R20L   is op0_8=0x34; op3_5=0b10100 & R20L; IntPX24   { IntPX24 = R20L;   }
:MV IntBPPX24,R20L is op0_8=0x24; op3_5=0b10100 & R20L; IntBPPX24 { IntBPPX24 = R20L; }

# mv [imm20],r20

:MV Ext24,R20L is op3_5=0b10101 & R20L; Ext24 { Ext24 = R20L; }

# mv [r20],xyu

:MV Ptr24,XYUL is op3_5=0b10110 & XYUL; op3_5=0b00000 & Ptr24 { Ptr24 = XYUL; }

# mv [r20++],xyu
# mv [--r20],xyu

:MV MemRegIncDec24,XYUL is op3_5=0b10110 & XYUL; MemRegIncDec24 { MemRegIncDec24 = XYUL; }

# mv [r20+off],xyu

:MV [R20L+off8],XYUL is op3_5=0b10110 & XYUL; op3_5=0b10000 & R20L; off8 { wr20(R20L + off8, XYUL); }
:MV [R20L-off8],XYUL is op3_5=0b10110 & XYUL; op3_5=0b11000 & R20L; off8 { wr20(R20L - off8, XYUL); }

# mv [(int)],xyu

:MV [IntN20],XYUL    is op0_8=0x30; op3_5=0b10111 & XYUL; op0_8=0x00; IntN20    { wr20(IntN20, XYUL);    }
:MV [IntBP20],XYUL   is             op3_5=0b10111 & XYUL; op0_8=0x00; IntBP20   { wr20(IntBP20, XYUL);   }
:MV [IntPX20],XYUL   is op0_8=0x34; op3_5=0b10111 & XYUL; op0_8=0x00; IntPX20   { wr20(IntPX20, XYUL);   }
:MV [IntBPPX20],XYUL is op0_8=0x24; op3_5=0b10111 & XYUL; op0_8=0x00; IntBPPX20 { wr20(IntBPPX20, XYUL); }

# mv [(int)+off],xyu

:MV [IntN20+off8],XYUL    is op0_8=0x30; op3_5=0b10111 & XYUL; op0_8=0x80; IntN20;    off8 { wr20(IntN20+off8, XYUL);    }
:MV [IntBP20+off8],XYUL   is             op3_5=0b10111 & XYUL; op0_8=0x80; IntBP20;   off8 { wr20(IntBP20+off8, XYUL);   }
:MV [IntPX20+off8],XYUL   is op0_8=0x34; op3_5=0b10111 & XYUL; op0_8=0x80; IntPX20;   off8 { wr20(IntPX20+off8, XYUL);   }
:MV [IntBPPX20+off8],XYUL is op0_8=0x24; op3_5=0b10111 & XYUL; op0_8=0x80; IntBPPX20; off8 { wr20(IntBPPX20+off8, XYUL); }

:MV [IntN20-off8],XYUL    is op0_8=0x30; op3_5=0b10111 & XYUL; op0_8=0xC0; IntN20;    off8 { wr20(IntN20-off8, XYUL);    }
:MV [IntBP20-off8],XYUL   is             op3_5=0b10111 & XYUL; op0_8=0xC0; IntBP20;   off8 { wr20(IntBP20-off8, XYUL);   }
:MV [IntPX20-off8],XYUL   is op0_8=0x34; op3_5=0b10111 & XYUL; op0_8=0xC0; IntPX20;   off8 { wr20(IntPX20-off8, XYUL);   }
:MV [IntBPPX20-off8],XYUL is op0_8=0x24; op3_5=0b10111 & XYUL; op0_8=0xC0; IntBPPX20; off8 { wr20(IntBPPX20-off8, XYUL); }

# mv r20,(int)

:MV R20L,IntN20    is op0_8=0x30; op3_5=0b10000 & R20L; IntN20    { R20L = IntN20;    }
:MV R20L,IntBP20   is             op3_5=0b10000 & R20L; IntBP20   { R20L = IntBP20;   }
:MV R20L,IntPX20   is op0_8=0x34; op3_5=0b10000 & R20L; IntPX20   { R20L = IntPX20;   }
:MV R20L,IntBPPX20 is op0_8=0x24; op3_5=0b10000 & R20L; IntBPPX20 { R20L = IntBPPX20; }

# mvp (int),(int)

:MVP IntN24,IntN24_2     is op0_8=0x32; op0_8=0xCA; IntN24;    IntN24_2  { IntN24 = IntN24_2;     }
:MVP IntBP24,IntN24      is op0_8=0x22; op0_8=0xCA; IntBP24;   IntN24    { IntBP24 = IntN24;      }
:MVP IntPX24,IntN24      is op0_8=0x36; op0_8=0xCA; IntPX24;   IntN24    { IntPX24 = IntN24;      }
:MVP IntBPPX24,IntN24    is op0_8=0x26; op0_8=0xCA; IntBPPX24; IntN24    { IntBPPX24 = IntN24;    }
:MVP IntN24,IntBP24      is op0_8=0x30; op0_8=0xCA; IntN24;    IntBP24   { IntN24 = IntBP24;      }
:MVP IntBP24,IntBP24_2   is             op0_8=0xCA; IntBP24;   IntBP24_2 { IntBP24 = IntBP24_2;   }
:MVP IntPX24,IntBP24     is op0_8=0x34; op0_8=0xCA; IntPX24;   IntBP24   { IntPX24 = IntBP24;     }
:MVP IntBPPX24,IntBP24   is op0_8=0x24; op0_8=0xCA; IntBPPX24; IntBP24   { IntBPPX24 = IntBP24;   }
:MVP IntN24,IntPY24      is op0_8=0x33; op0_8=0xCA; IntN24;    IntPY24   { IntN24 = IntPY24;      }
:MVP IntBP24,IntPY24     is op0_8=0x23; op0_8=0xCA; IntBP24;   IntPY24   { IntBP24 = IntPY24;     }
:MVP IntPX24,IntPY24     is op0_8=0x37; op0_8=0xCA; IntPX24;   IntPY24   { IntPX24 = IntPY24;     }
:MVP IntBPPX24,IntPY24   is op0_8=0x27; op0_8=0xCA; IntBPPX24; IntPY24   { IntBPPX24 = IntPY24;   }
:MVP IntN24,IntBPPY24    is op0_8=0x31; op0_8=0xCA; IntN24;    IntBPPY24 { IntN24 = IntBPPY24;    }
:MVP IntBP24,IntBPPY24   is op0_8=0x21; op0_8=0xCA; IntBP24;   IntBPPY24 { IntBP24 = IntBPPY24;   }
:MVP IntPX24,IntBPPY24   is op0_8=0x35; op0_8=0xCA; IntPX24;   IntBPPY24 { IntPX24 = IntBPPY24;   }
:MVP IntBPPX24,IntBPPY24 is op0_8=0x25; op0_8=0xCA; IntBPPX24; IntBPPY24 { IntBPPX24 = IntBPPY24; }

# mvp [imm20],(int)

:MVP Ext24,IntBP24   is             op0_8=0xDA; Ext24; IntBP24   { Ext24 = IntBP24;   }
:MVP Ext24,IntN24    is op0_8=0x30; op0_8=0xDA; Ext24; IntN24    { Ext24 = IntN24;    }
:MVP Ext24,IntPX24   is op0_8=0x34; op0_8=0xDA; Ext24; IntPX24   { Ext24 = IntPX24;   }
:MVP Ext24,IntBPPX24 is op0_8=0x24; op0_8=0xDA; Ext24; IntBPPX24 { Ext24 = IntBPPX24; }

# mvp [r20],(int)

:MVP Ptr24,IntN24    is op0_8=0x30; op0_8=0xEA; op3_5=0b00000 & Ptr24; IntN24    { Ptr24 = IntN24;    }
:MVP Ptr24,IntBP24   is             op0_8=0xEA; op3_5=0b00000 & Ptr24; IntBP24   { Ptr24 = IntBP24;   }
:MVP Ptr24,IntPX24   is op0_8=0x34; op0_8=0xEA; op3_5=0b00000 & Ptr24; IntPX24   { Ptr24 = IntPX24;   }
:MVP Ptr24,IntBPPX24 is op0_8=0x24; op0_8=0xEA; op3_5=0b00000 & Ptr24; IntBPPX24 { Ptr24 = IntBPPX24; }

