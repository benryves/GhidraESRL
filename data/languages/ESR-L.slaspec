:MV IntPX8,[IntBP20+off8]     is op0_8=0x34; op0_8=0xF0; op0_8=0x80; IntPX8;   IntBP20;   off8 { rd8(IntPX8, IntBP20+off8);     }
:MV IntBPPX8,[IntBP20+off8]   is op0_8=0x24; op0_8=0xF0; op0_8=0x80; IntBPPX8; IntBP20;   off8 { rd8(IntBPPX8, IntBP20+off8);   }
:MV IntN8,[IntPY20+off8]      is op0_8=0x33; op0_8=0xF0; op0_8=0x80; IntN8;    IntPY20;   off8 { rd8(IntN8, IntPY20+off8);      }
:MV IntBP8,[IntPY20+off8]     is op0_8=0x23; op0_8=0xF0; op0_8=0x80; IntBP8;   IntPY20;   off8 { rd8(IntBP8, IntPY20+off8);     }
:MV IntPX8,[IntPY20+off8]     is op0_8=0x37; op0_8=0xF0; op0_8=0x80; IntPX8;   IntPY20;   off8 { rd8(IntPX8, IntPY20+off8);     }
:MV IntBPPX8,[IntPY20+off8]   is op0_8=0x27; op0_8=0xF0; op0_8=0x80; IntBPPX8; IntPY20;   off8 { rd8(IntBPPX8, IntPY20+off8);   }
:MV IntN8,[IntBPPY20+off8]    is op0_8=0x31; op0_8=0xF0; op0_8=0x80; IntN8;    IntBPPY20; off8 { rd8(IntN8, IntBPPY20+off8);    }
:MV IntBP8,[IntBPPY20+off8]   is op0_8=0x21; op0_8=0xF0; op0_8=0x80; IntBP8;   IntBPPY20; off8 { rd8(IntBP8, IntBPPY20+off8);   }
:MV IntPX8,[IntBPPY20+off8]   is op0_8=0x35; op0_8=0xF0; op0_8=0x80; IntPX8;   IntBPPY20; off8 { rd8(IntPX8, IntBPPY20+off8);   }
:MV IntBPPX8,[IntBPPY20+off8] is op0_8=0x25; op0_8=0xF0; op0_8=0x80; IntBPPX8; IntBPPY20; off8 { rd8(IntBPPX8, IntBPPY20+off8); }

:MV IntN8,[IntN20-off8]       is op0_8=0x32; op0_8=0xF0; op0_8=0xC0; IntN8;    IntN20;    off8 { rd8(IntN8, IntN20-off8);       }
:MV IntBP8,[IntN20-off8]      is op0_8=0x22; op0_8=0xF0; op0_8=0xC0; IntBP8;   IntN20;    off8 { rd8(IntBP8, IntN20-off8);      }
:MV IntPX8,[IntN20-off8]      is op0_8=0x36; op0_8=0xF0; op0_8=0xC0; IntPX8;   IntN20;    off8 { rd8(IntPX8, IntN20-off8);      }
:MV IntBPPX8,[IntN20-off8]    is op0_8=0x26; op0_8=0xF0; op0_8=0xC0; IntBPPX8; IntN20;    off8 { rd8(IntBPPX8, IntN20-off8);    }
:MV IntN8,[IntBP20-off8]      is op0_8=0x30; op0_8=0xF0; op0_8=0xC0; IntN8;    IntBP20;   off8 { rd8(IntN8, IntBP20-off8);      }
:MV IntBP8,[IntBP20-off8]     is             op0_8=0xF0; op0_8=0xC0; IntBP8;   IntBP20;   off8 { rd8(IntBP8, IntBP20-off8);     }
:MV IntPX8,[IntBP20-off8]     is op0_8=0x34; op0_8=0xF0; op0_8=0xC0; IntPX8;   IntBP20;   off8 { rd8(IntPX8, IntBP20-off8);     }
:MV IntBPPX8,[IntBP20-off8]   is op0_8=0x24; op0_8=0xF0; op0_8=0xC0; IntBPPX8; IntBP20;   off8 { rd8(IntBPPX8, IntBP20-off8);   }
:MV IntN8,[IntPY20-off8]      is op0_8=0x33; op0_8=0xF0; op0_8=0xC0; IntN8;    IntPY20;   off8 { rd8(IntN8, IntPY20-off8);      }
:MV IntBP8,[IntPY20-off8]     is op0_8=0x23; op0_8=0xF0; op0_8=0xC0; IntBP8;   IntPY20;   off8 { rd8(IntBP8, IntPY20-off8);     }
:MV IntPX8,[IntPY20-off8]     is op0_8=0x37; op0_8=0xF0; op0_8=0xC0; IntPX8;   IntPY20;   off8 { rd8(IntPX8, IntPY20-off8);     }
:MV IntBPPX8,[IntPY20-off8]   is op0_8=0x27; op0_8=0xF0; op0_8=0xC0; IntBPPX8; IntPY20;   off8 { rd8(IntBPPX8, IntPY20-off8);   }
:MV IntN8,[IntBPPY20-off8]    is op0_8=0x31; op0_8=0xF0; op0_8=0xC0; IntN8;    IntBPPY20; off8 { rd8(IntN8, IntBPPY20-off8);    }
:MV IntBP8,[IntBPPY20-off8]   is op0_8=0x21; op0_8=0xF0; op0_8=0xC0; IntBP8;   IntBPPY20; off8 { rd8(IntBP8, IntBPPY20-off8);   }
:MV IntPX8,[IntBPPY20-off8]   is op0_8=0x35; op0_8=0xF0; op0_8=0xC0; IntPX8;   IntBPPY20; off8 { rd8(IntPX8, IntBPPY20-off8);   }
:MV IntBPPX8,[IntBPPY20-off8] is op0_8=0x25; op0_8=0xF0; op0_8=0xC0; IntBPPX8; IntBPPY20; off8 { rd8(IntBPPX8, IntBPPY20-off8); }

### 2 Byte Transmission Command No. 1

# mv r16,imm16

:MV R16L,imm16 is op3_5=0x01 & R16L; imm16 { R16L = imm16; }

# mvw (int),imm16

:MVW IntN16,imm16    is op0_8=0x30; op0_8=0xCD; IntN16;    imm16 { IntN16 = imm16;    }
:MVW IntBP16,imm16   is             op0_8=0xCD; IntBP16;   imm16 { IntBP16 = imm16;   }
:MVW IntPX16,imm16   is op0_8=0x34; op0_8=0xCD; IntPX16;   imm16 { IntPX16 = imm16;   }
:MVW IntBPPX16,imm16 is op0_8=0x24; op0_8=0xCD; IntBPPX16; imm16 { IntBPPX16 = imm16; }

# mv r16,r16

:MV R16H,R16L is op0_8=0xFD; R16H & R16L { R16H = R16L; }

# mv (int),r16

:MV IntN16,R16L    is op0_8=0x30; op3_5=0b10100 & R16L; IntN16    { IntN16 = R16L;    }
:MV IntBP16,R16L   is             op3_5=0b10100 & R16L; IntBP16   { IntBP16 = R16L;   }
:MV IntPX16,R16L   is op0_8=0x34; op3_5=0b10100 & R16L; IntPX16   { IntPX16 = R16L;   }
:MV IntBPPX16,R16L is op0_8=0x24; op3_5=0b10100 & R16L; IntBPPX16 { IntBPPX16 = R16L; }

# mv [imm20],r16

:MV Ext16,R16L is op3_5=0b10101 & R16L; Ext16 { Ext16 = R16L; }

# mv [r20],r16

:MV Ptr16,R16L is op3_5=0b10110 & R16L; op3_5=0b00000 & Ptr16 { Ptr16 = R16L; }

# mv [r20++],r16
# mv [--r20],r16

:MV MemRegIncDec16,R16L is op3_5=0b10110 & R16L; MemRegIncDec16 { MemRegIncDec16 = R16L; }

# mv [r20+off],r16

:MV [R20L+off8],R16L is op3_5=0b10110 & R16L; op3_5=0b10000 & R20L; off8 { wr16(R20L + off8, R16L); }
:MV [R20L-off8],R16L is op3_5=0b10110 & R16L; op3_5=0b11000 & R20L; off8 { wr16(R20L - off8, R16L); }

# mv [(int)],r16

:MV [IntN20],R16L    is op0_8=0x30; op3_5=0b10111 & R16L; op0_8=0x00; IntN20    { wr16(IntN20, R16L);    }
:MV [IntBP20],R16L   is             op3_5=0b10111 & R16L; op0_8=0x00; IntBP20   { wr16(IntBP20, R16L);   }
:MV [IntPX20],R16L   is op0_8=0x34; op3_5=0b10111 & R16L; op0_8=0x00; IntPX20   { wr16(IntPX20, R16L);   }
:MV [IntBPPX20],R16L is op0_8=0x24; op3_5=0b10111 & R16L; op0_8=0x00; IntBPPX20 { wr16(IntBPPX20, R16L); }

# mv [(int)+off],r16

:MV [IntN20+off8],R16L    is op0_8=0x30; op3_5=0b10111 & R16L; op0_8=0x80; IntN20;    off8 { wr16(IntN20+off8, R16L);    }
:MV [IntBP20+off8],R16L   is             op3_5=0b10111 & R16L; op0_8=0x80; IntBP20;   off8 { wr16(IntBP20+off8, R16L);   }
:MV [IntPX20+off8],R16L   is op0_8=0x34; op3_5=0b10111 & R16L; op0_8=0x80; IntPX20;   off8 { wr16(IntPX20+off8, R16L);   }
:MV [IntBPPX20+off8],R16L is op0_8=0x24; op3_5=0b10111 & R16L; op0_8=0x80; IntBPPX20; off8 { wr16(IntBPPX20+off8, R16L); }

:MV [IntN20-off8],R16L    is op0_8=0x30; op3_5=0b10111 & R16L; op0_8=0xC0; IntN20;    off8 { wr16(IntN20-off8, R16L);    }
:MV [IntBP20-off8],R16L   is             op3_5=0b10111 & R16L; op0_8=0xC0; IntBP20;   off8 { wr16(IntBP20-off8, R16L);   }
:MV [IntPX20-off8],R16L   is op0_8=0x34; op3_5=0b10111 & R16L; op0_8=0xC0; IntPX20;   off8 { wr16(IntPX20-off8, R16L);   }
:MV [IntBPPX20-off8],R16L is op0_8=0x24; op3_5=0b10111 & R16L; op0_8=0xC0; IntBPPX20; off8 { wr16(IntBPPX20-off8, R16L); }

# mv r16,(int)

:MV R16L,IntN16    is op0_8=0x30; op3_5=0b10000 & R16L; IntN16    { R16L = IntN16;    }
:MV R16L,IntBP16   is             op3_5=0b10000 & R16L; IntBP16   { R16L = IntBP16;   }
:MV R16L,IntPX16   is op0_8=0x34; op3_5=0b10000 & R16L; IntPX16   { R16L = IntPX16;   }
:MV R16L,IntBPPX16 is op0_8=0x24; op3_5=0b10000 & R16L; IntBPPX16 { R16L = IntBPPX16; }

# mvw (int),(int)

:MVW IntN16,IntN16_2     is op0_8=0x32; op0_8=0xC9; IntN16;    IntN16_2  { IntN16 = IntN16_2;     }
:MVW IntBP16,IntN16      is op0_8=0x22; op0_8=0xC9; IntBP16;   IntN16    { IntBP16 = IntN16;      }
:MVW IntPX16,IntN16      is op0_8=0x36; op0_8=0xC9; IntPX16;   IntN16    { IntPX16 = IntN16;      }
:MVW IntBPPX16,IntN16    is op0_8=0x26; op0_8=0xC9; IntBPPX16; IntN16    { IntBPPX16 = IntN16;    }
:MVW IntN16,IntBP16      is op0_8=0x30; op0_8=0xC9; IntN16;    IntBP16   { IntN16 = IntBP16;      }
:MVW IntBP16,IntBP16_2   is             op0_8=0xC9; IntBP16;   IntBP16_2 { IntBP16 = IntBP16_2;   }
:MVW IntPX16,IntBP16     is op0_8=0x34; op0_8=0xC9; IntPX16;   IntBP16   { IntPX16 = IntBP16;     }
:MVW IntBPPX16,IntBP16   is op0_8=0x24; op0_8=0xC9; IntBPPX16; IntBP16   { IntBPPX16 = IntBP16;   }
:MVW IntN16,IntPY16      is op0_8=0x33; op0_8=0xC9; IntN16;    IntPY16   { IntN16 = IntPY16;      }
:MVW IntBP16,IntPY16     is op0_8=0x23; op0_8=0xC9; IntBP16;   IntPY16   { IntBP16 = IntPY16;     }
:MVW IntPX16,IntPY16     is op0_8=0x37; op0_8=0xC9; IntPX16;   IntPY16   { IntPX16 = IntPY16;     }
:MVW IntBPPX16,IntPY16   is op0_8=0x27; op0_8=0xC9; IntBPPX16; IntPY16   { IntBPPX16 = IntPY16;   }
:MVW IntN16,IntBPPY16    is op0_8=0x31; op0_8=0xC9; IntN16;    IntBPPY16 { IntN16 = IntBPPY16;    }
:MVW IntBP16,IntBPPY16   is op0_8=0x21; op0_8=0xC9; IntBP16;   IntBPPY16 { IntBP16 = IntBPPY16;   }
:MVW IntPX16,IntBPPY16   is op0_8=0x35; op0_8=0xC9; IntPX16;   IntBPPY16 { IntPX16 = IntBPPY16;   }
:MVW IntBPPX16,IntBPPY16 is op0_8=0x25; op0_8=0xC9; IntBPPX16; IntBPPY16 { IntBPPX16 = IntBPPY16; }

# mvw [imm20],(int)

:MVW Ext16,IntBP16   is             op0_8=0xD9; Ext16; IntBP16   { Ext16 = IntBP16;   }
:MVW Ext16,IntN16    is op0_8=0x30; op0_8=0xD9; Ext16; IntN16    { Ext16 = IntN16;    }
:MVW Ext16,IntPX16   is op0_8=0x34; op0_8=0xD9; Ext16; IntPX16   { Ext16 = IntPX16;   }
:MVW Ext16,IntBPPX16 is op0_8=0x24; op0_8=0xD9; Ext16; IntBPPX16 { Ext16 = IntBPPX16; }

# mvw [r20],(int)

:MVW Ptr16,IntN16    is op0_8=0x30; op0_8=0xE9; op3_5=0b00000 & Ptr16; IntN16    { Ptr16 = IntN16;    }
:MVW Ptr16,IntBP16   is             op0_8=0xE9; op3_5=0b00000 & Ptr16; IntBP16   { Ptr16 = IntBP16;   }
:MVW Ptr16,IntPX16   is op0_8=0x34; op0_8=0xE9; op3_5=0b00000 & Ptr16; IntPX16   { Ptr16 = IntPX16;   }
:MVW Ptr16,IntBPPX16 is op0_8=0x24; op0_8=0xE9; op3_5=0b00000 & Ptr16; IntBPPX16 { Ptr16 = IntBPPX16; }

